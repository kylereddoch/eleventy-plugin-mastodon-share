<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title or "Demo" }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% mastodonShareStyles %}
  <link rel="stylesheet" href="/assets/demo.css">
</head>
<body>
  <main class="wrapper">
    <header>
      <h1>{{ title }}</h1>
      <p><a href="/posts/demo-post/">Demo Post</a></p>
    </header>

    <article>
      {{ content | safe }}
    </article>
  </main>

  {% mastodonShareScript %}
</body>
</html>
