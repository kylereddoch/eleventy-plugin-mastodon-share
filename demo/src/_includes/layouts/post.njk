---
layout: layouts/base.njk
---

<article class="flow">
  <h1>{{ title }}</h1>
  <p class="lead">{{ description }}</p>

  {{ content | safe }}

  <div class="flow" style="margin-top: 2rem;">
    <h3>Share</h3>
    <p>If this helped, consider sharing it on Mastodon.</p>

    {# Build share text like your site #}
    {% set fullUrl  = page.url | url | absoluteUrl(site.url) %}
    {% set hashtags = mastodon_hashtags | default([]) %}

    {% set tagsInline = "" %}
    {% if (hashtags | length) > 0 %}
      {% set tagsInline = "\n\n#" ~ (hashtags | join(' #')) %}
    {% endif %}

    {% set text = (title ~ " — " ~ (description or "")) ~ "\n\n" ~ fullUrl ~ tagsInline %}

    {# Render the plugin shortcode #}
    {% mastodonShare text=text hashtags=hashtags %}
  </div>
</article>
