---
layout: layouts/base.njk
---

<article class="flow">
  <h1>{{ title }}</h1>
  <p class="lead">{{ description }}</p>

  {{ content | safe }}

  <div class="flow" style="margin-top: 2rem;">
    <h2>Share This Post</h2>
    <p>The shortcode below only needs the post metadata. The plugin builds the Mastodon text and canonical URL for you.</p>

    {% mastodonSharePost title, description, mastodon_hashtags %}
  </div>
</article>
